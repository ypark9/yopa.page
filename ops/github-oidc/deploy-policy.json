{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SiteS3Metadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::yopa.page",
        "arn:aws:s3:::yopa.page-cloudfront-logs-831597648506",
        "arn:aws:s3:::terraform.yopa.page"
      ]
    },
    {
      "Sid": "SiteStateRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::terraform.yopa.page/env/global/terraform.tfstate",
        "arn:aws:s3:::terraform.yopa.page/env/prod/terraform.tfstate"
      ]
    },
    {
      "Sid": "CloudFrontAndCertificateRead",
      "Effect": "Allow",
      "Action": [
        "cloudfront:Get*",
        "cloudfront:List*",
        "acm:ListCertificates",
        "acm:DescribeCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PresenceRoleRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::831597648506:role/article-atlas-presence-lambda-role"
    },
    {
      "Sid": "PresenceLambdaRead",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:GetFunctionConcurrency"
      ],
      "Resource": "arn:aws:lambda:us-east-1:831597648506:function:article-atlas-presence-handler"
    },
    {
      "Sid": "PresenceTableRead",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:831597648506:table/article-atlas-presence"
    },
    {
      "Sid": "PresenceApiRead",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/dueijpig2e",
        "arn:aws:apigateway:us-east-1::/apis/dueijpig2e/*"
      ]
    },
    {
      "Sid": "PresenceLogRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PresenceLogTags",
      "Effect": "Allow",
      "Action": [
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/lambda/article-atlas-presence-handler",
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/apigateway/article-atlas-presence",
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/lambda/article-atlas-presence-handler:*",
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/apigateway/article-atlas-presence:*"
      ]
    },
    {
      "Sid": "SiteContentWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::yopa.page/*"
    },
    {
      "Sid": "SiteStateWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::terraform.yopa.page/env/global/terraform.tfstate",
        "arn:aws:s3:::terraform.yopa.page/env/prod/terraform.tfstate"
      ]
    },
    {
      "Sid": "SiteStateLocks",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::terraform.yopa.page/env/global/terraform.tfstate.tflock",
        "arn:aws:s3:::terraform.yopa.page/env/prod/terraform.tfstate.tflock"
      ]
    },
    {
      "Sid": "SiteBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketAcl",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::yopa.page",
        "arn:aws:s3:::yopa.page-cloudfront-logs-831597648506"
      ]
    },
    {
      "Sid": "SiteDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateDistribution",
        "cloudfront:CreateInvalidation",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::831597648506:distribution/E1E6POSO3R4FYB"
    },
    {
      "Sid": "SiteCachePolicy",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateCachePolicy"
      ],
      "Resource": "arn:aws:cloudfront::831597648506:cache-policy/10e7009a-a7fe-449d-a536-5291acba09d4"
    },
    {
      "Sid": "SiteHeadersPolicy",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateResponseHeadersPolicy"
      ],
      "Resource": "arn:aws:cloudfront::831597648506:response-headers-policy/3f82a0b9-0262-4893-9098-066da29e5b83"
    },
    {
      "Sid": "SiteFunctions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction"
      ],
      "Resource": [
        "arn:aws:cloudfront::831597648506:function/yopa-draw-index-rewrite",
        "arn:aws:cloudfront::831597648506:function/article-atlas-presence-rewrite"
      ]
    },
    {
      "Sid": "PresenceLambdaWrite",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionConcurrency",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:us-east-1:831597648506:function:article-atlas-presence-handler"
    },
    {
      "Sid": "PresenceExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::831597648506:role/article-atlas-presence-lambda-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
