{
  "contents": [
    {
      "uri": "ui://fleet-experiment/card-permissive",
      "mimeType": "text/html;profile=mcp-app",
      "_meta": {
        "ui": {
          "csp": {
            "connectDomains": [
              "https://api.github.com"
            ],
            "resourceDomains": [
              "https://cdn.jsdelivr.net"
            ]
          },
          "prefersBorder": true
        }
      },
      "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Fleet card</title>\n    <style>\n      :root {\n        color-scheme: light dark;\n        font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n      }\n      body {\n        margin: 0;\n        padding: 12px;\n        font-size: 13px;\n        line-height: 1.45;\n      }\n      h2 {\n        font-size: 14px;\n        margin: 0 0 8px;\n      }\n      h3 {\n        font-size: 12px;\n        text-transform: uppercase;\n        letter-spacing: 0.06em;\n        opacity: 0.6;\n        margin: 16px 0 6px;\n      }\n      table {\n        border-collapse: collapse;\n        width: 100%;\n      }\n      th,\n      td {\n        text-align: left;\n        padding: 4px 8px 4px 0;\n        border-bottom: 1px solid rgba(128, 128, 128, 0.3);\n        font-variant-numeric: tabular-nums;\n      }\n      code,\n      pre {\n        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n        font-size: 11px;\n      }\n      pre {\n        white-space: pre-wrap;\n        word-break: break-all;\n        background: rgba(128, 128, 128, 0.12);\n        padding: 8px;\n        border-radius: 4px;\n        margin: 0;\n      }\n      .probe {\n        display: flex;\n        gap: 8px;\n        align-items: baseline;\n        padding: 2px 0;\n      }\n      .tag {\n        display: inline-block;\n        min-width: 58px;\n        font-weight: 700;\n        font-size: 11px;\n      }\n      .pass {\n        color: #0a7a3d;\n      }\n      .fail {\n        color: #b3261e;\n      }\n      .wait {\n        opacity: 0.55;\n      }\n      #probe-img {\n        height: 14px;\n        vertical-align: middle;\n      }\n    </style>\n    <!--\n      PROBE C (stylesheet/font from an origin that is NOT declared by either\n      resource). Under SEP-1865 this must be blocked in both the default-CSP\n      and declared-CSP cases, because a host MUST NOT allow undeclared domains.\n      It is the control that separates \"the host enforces a policy\" from\n      \"the host enforces nothing\".\n    -->\n    <link\n      id=\"probe-font\"\n      rel=\"stylesheet\"\n      href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400&display=swap\"\n    />\n  </head>\n  <body>\n    <h2 id=\"title\">Fleet card <span class=\"wait\">(waiting for tool result…)</span></h2>\n\n    <div id=\"data\">\n      <p class=\"wait\">\n        No <code>ui/notifications/tool-result</code> received yet. If this text persists,\n        the host rendered the resource but never delivered the structured data.\n      </p>\n    </div>\n\n    <h3>Asset probes</h3>\n    <div id=\"probes\">\n      <div class=\"probe\">\n        <span class=\"tag wait\" id=\"t-inline\">…</span>\n        <span>A. inline <code>data:</code> image — allowed by the restrictive default</span>\n        <img id=\"probe-img\" alt=\"\" />\n      </div>\n      <div class=\"probe\">\n        <span class=\"tag wait\" id=\"t-cdn\">…</span>\n        <span>B. external image <code>cdn.jsdelivr.net</code> — declared only by the permissive resource</span>\n      </div>\n      <div class=\"probe\">\n        <span class=\"tag wait\" id=\"t-font\">…</span>\n        <span>C. external stylesheet <code>fonts.googleapis.com</code> — declared by neither (control)</span>\n      </div>\n      <div class=\"probe\">\n        <span class=\"tag wait\" id=\"t-fetch-declared\">…</span>\n        <span>D. <code>fetch()</code> to <code>api.github.com</code> — declared only by the permissive resource</span>\n      </div>\n      <div class=\"probe\">\n        <span class=\"tag wait\" id=\"t-fetch-undeclared\">…</span>\n        <span>E. <code>fetch()</code> to <code>example.com</code> — declared by neither (control)</span>\n      </div>\n      <div class=\"probe\">\n        <span class=\"tag wait\" id=\"t-frame\">…</span>\n        <span>F. nested <code>&lt;iframe&gt;</code> — <code>frame-src 'none'</code> unless declared</span>\n      </div>\n    </div>\n\n    <h3>Sandbox &amp; policy observed</h3>\n    <pre id=\"env\">collecting…</pre>\n\n    <h3>CSP violations reported to the view</h3>\n    <pre id=\"csp\">none observed yet</pre>\n\n    <script>\n      \"use strict\";\n\n      // ----------------------------------------------------------------- //\n      // Report object. Mirrored to the console with a tag so the harness can\n      // scrape it out of DevTools without needing same-origin access to this\n      // frame (the sandbox proxy gives it a different origin than the host).\n      // ----------------------------------------------------------------- //\n      const report = {\n        startedAt: new Date().toISOString(),\n        env: {},\n        probes: {},\n        cspViolations: [],\n        lifecycle: [],\n        toolResult: null,\n        toolInput: null,\n      };\n\n      function emit() {\n        try {\n          document.getElementById(\"env\").textContent = JSON.stringify(report.env, null, 2);\n          document.getElementById(\"csp\").textContent = report.cspViolations.length\n            ? JSON.stringify(report.cspViolations, null, 2)\n            : \"none observed yet\";\n        } catch (_) {}\n        try {\n          console.log(\"__MCPAPP_PROBE__ \" + JSON.stringify(report));\n        } catch (_) {}\n      }\n\n      function mark(id, key, ok, detail) {\n        report.probes[key] = { ok, detail, at: new Date().toISOString() };\n        const el = document.getElementById(id);\n        if (el) {\n          el.textContent = ok ? \"LOADED\" : \"BLOCKED\";\n          el.className = \"tag \" + (ok ? \"pass\" : \"fail\");\n        }\n        emit();\n      }\n\n      // ----------------------------------------------------------------- //\n      // CSP violation listener. `originalPolicy` is the single most valuable\n      // field in this whole experiment: it is the exact policy the host\n      // applied, reported by the browser itself rather than inferred.\n      // ----------------------------------------------------------------- //\n      document.addEventListener(\"securitypolicyviolation\", (e) => {\n        report.cspViolations.push({\n          blockedURI: e.blockedURI,\n          violatedDirective: e.violatedDirective,\n          effectiveDirective: e.effectiveDirective,\n          originalPolicy: e.originalPolicy,\n          disposition: e.disposition,\n          sourceFile: e.sourceFile,\n        });\n        emit();\n      });\n\n      // ----------------------------------------------------------------- //\n      // Environment facts\n      // ----------------------------------------------------------------- //\n      function collectEnv() {\n        const env = {\n          href: location.href,\n          origin: location.origin,\n          ancestorOrigins: (() => {\n            try {\n              return Array.from(location.ancestorOrigins || []);\n            } catch (e) {\n              return \"unavailable: \" + e.name;\n            }\n          })(),\n          isFramed: window.parent !== window,\n          frameDepth: (() => {\n            let d = 0;\n            let w = window;\n            try {\n              while (w.parent !== w && d < 10) {\n                d += 1;\n                w = w.parent;\n              }\n            } catch (_) {}\n            return d;\n          })(),\n          // An opaque origin (\"null\") is the signature of a sandboxed iframe\n          // WITHOUT allow-same-origin.\n          opaqueOrigin: location.origin === \"null\",\n          cookieAccess: (() => {\n            try {\n              void document.cookie;\n              return \"ok\";\n            } catch (e) {\n              return \"throws: \" + e.name;\n            }\n          })(),\n          localStorageAccess: (() => {\n            try {\n              window.localStorage.getItem(\"probe\");\n              return \"ok\";\n            } catch (e) {\n              return \"throws: \" + e.name;\n            }\n          })(),\n          canTopNavigate: (() => {\n            try {\n              return typeof window.top.location.href === \"string\" ? \"same-origin-top\" : \"unknown\";\n            } catch (e) {\n              return \"cross-origin-top (\" + e.name + \")\";\n            }\n          })(),\n          userAgentData: navigator.userAgent,\n        };\n        report.env = env;\n        emit();\n      }\n\n      // ----------------------------------------------------------------- //\n      // Probes\n      // ----------------------------------------------------------------- //\n\n      // A. inline data: image\n      (function probeInline() {\n        const img = document.getElementById(\"probe-img\");\n        const dataUri =\n          \"data:image/svg+xml;base64,\" +\n          btoa(\n            '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\"><circle cx=\"7\" cy=\"7\" r=\"6\" fill=\"#0a7a3d\"/></svg>',\n          );\n        img.onload = () => mark(\"t-inline\", \"inlineDataImage\", true, dataUri.slice(0, 32) + \"…\");\n        img.onerror = () => mark(\"t-inline\", \"inlineDataImage\", false, \"error event\");\n        img.src = dataUri;\n      })();\n\n      // B. external image from a declared-by-permissive origin\n      (function probeCdnImage() {\n        const url = \"https://cdn.jsdelivr.net/npm/simple-icons@13.0.0/icons/nodedotjs.svg\";\n        const img = new Image();\n        img.onload = () => mark(\"t-cdn\", \"externalImageDeclared\", true, url);\n        img.onerror = () => mark(\"t-cdn\", \"externalImageDeclared\", false, url);\n        img.src = url;\n        setTimeout(() => {\n          if (!report.probes.externalImageDeclared) {\n            mark(\"t-cdn\", \"externalImageDeclared\", false, \"timeout (no load/error within 6s)\");\n          }\n        }, 6000);\n      })();\n\n      // C. external stylesheet, declared by neither resource\n      (function probeFont() {\n        const link = document.getElementById(\"probe-font\");\n        const settle = () => {\n          // A blocked stylesheet has no cssRules and sheet is null.\n          const loaded = !!link.sheet;\n          mark(\n            \"t-font\",\n            \"externalStylesheetUndeclared\",\n            loaded,\n            loaded ? \"sheet object present\" : \"link.sheet is null\",\n          );\n        };\n        if (document.readyState === \"complete\") setTimeout(settle, 500);\n        else window.addEventListener(\"load\", () => setTimeout(settle, 500));\n      })();\n\n      // D. fetch to a declared-by-permissive origin\n      (function probeFetchDeclared() {\n        const url = \"https://api.github.com/zen\";\n        const ctl = new AbortController();\n        const timer = setTimeout(() => ctl.abort(), 6000);\n        fetch(url, { signal: ctl.signal })\n          .then((r) => r.text())\n          .then((t) =>\n            mark(\"t-fetch-declared\", \"fetchDeclared\", true, \"HTTP ok, body: \" + t.slice(0, 40)),\n          )\n          .catch((e) => mark(\"t-fetch-declared\", \"fetchDeclared\", false, e.name + \": \" + e.message))\n          .finally(() => clearTimeout(timer));\n      })();\n\n      // E. fetch to an origin declared by neither resource\n      (function probeFetchUndeclared() {\n        const url = \"https://example.com/\";\n        const ctl = new AbortController();\n        const timer = setTimeout(() => ctl.abort(), 6000);\n        fetch(url, { mode: \"no-cors\", signal: ctl.signal })\n          .then(() => mark(\"t-fetch-undeclared\", \"fetchUndeclared\", true, \"request left the frame\"))\n          .catch((e) =>\n            mark(\"t-fetch-undeclared\", \"fetchUndeclared\", false, e.name + \": \" + e.message),\n          )\n          .finally(() => clearTimeout(timer));\n      })();\n\n      // F. nested iframe\n      (function probeNestedFrame() {\n        const f = document.createElement(\"iframe\");\n        f.style.display = \"none\";\n        f.src = \"https://example.com/\";\n        f.onload = () => mark(\"t-frame\", \"nestedIframe\", true, \"load event fired\");\n        f.onerror = () => mark(\"t-frame\", \"nestedIframe\", false, \"error event\");\n        document.body.appendChild(f);\n        setTimeout(() => {\n          if (!report.probes.nestedIframe) {\n            mark(\"t-frame\", \"nestedIframe\", false, \"no load event within 6s\");\n          }\n        }, 6000);\n      })();\n\n      // ----------------------------------------------------------------- //\n      // MCP Apps lifecycle over postMessage (SEP-1865 §Transport Layer).\n      // Written without the SDK on purpose: the spec documents this raw shape,\n      // and doing it by hand means the experiment tests the protocol rather\n      // than a client library's convenience wrapper.\n      // ----------------------------------------------------------------- //\n      let nextId = 1;\n      const pending = new Map();\n\n      function sendRequest(method, params) {\n        const id = nextId++;\n        report.lifecycle.push({ dir: \"view->host\", kind: \"request\", method, id });\n        emit();\n        window.parent.postMessage({ jsonrpc: \"2.0\", id, method, params }, \"*\");\n        return new Promise((resolve, reject) => {\n          pending.set(id, { resolve, reject });\n          setTimeout(() => {\n            if (pending.has(id)) {\n              pending.delete(id);\n              reject(new Error(\"timeout waiting for response to \" + method));\n            }\n          }, 5000);\n        });\n      }\n\n      function sendNotification(method, params) {\n        report.lifecycle.push({ dir: \"view->host\", kind: \"notification\", method });\n        emit();\n        window.parent.postMessage({ jsonrpc: \"2.0\", method, params }, \"*\");\n      }\n\n      window.addEventListener(\"message\", (event) => {\n        const msg = event.data;\n        if (!msg || msg.jsonrpc !== \"2.0\") return;\n\n        if (msg.id !== undefined && pending.has(msg.id)) {\n          const { resolve, reject } = pending.get(msg.id);\n          pending.delete(msg.id);\n          report.lifecycle.push({ dir: \"host->view\", kind: \"response\", id: msg.id });\n          if (msg.error) reject(new Error(JSON.stringify(msg.error)));\n          else resolve(msg.result);\n          emit();\n          return;\n        }\n\n        if (msg.method) {\n          report.lifecycle.push({ dir: \"host->view\", kind: \"notification\", method: msg.method });\n          if (msg.method === \"ui/notifications/tool-result\") {\n            report.toolResult = msg.params;\n            renderData(msg.params);\n          }\n          if (msg.method === \"ui/notifications/tool-input\") {\n            report.toolInput = msg.params;\n          }\n          emit();\n        }\n      });\n\n      function renderData(params) {\n        const sc = params && params.structuredContent;\n        const title = document.getElementById(\"title\");\n        const host = document.getElementById(\"data\");\n        if (!sc || !Array.isArray(sc.unicorns)) {\n          host.innerHTML =\n            '<p class=\"fail\">tool-result arrived but structuredContent.unicorns was missing.</p>';\n          return;\n        }\n        title.textContent = \"Fleet card — \" + sc.unicorns.length + \" unicorn(s)\";\n        const rows = sc.unicorns\n          .map(\n            (u) =>\n              \"<tr><td>\" +\n              u.name +\n              \"</td><td><code>\" +\n              u.id +\n              \"</code></td><td>\" +\n              u.size +\n              \"</td><td>$\" +\n              u.hourlyRate +\n              \"/h</td><td>\" +\n              (u.available ? \"available\" : \"booked\") +\n              \"</td></tr>\",\n          )\n          .join(\"\");\n        host.innerHTML =\n          '<table><thead><tr><th>Name</th><th>ID</th><th>Size</th><th>Rate</th><th>Status</th></tr></thead><tbody>' +\n          rows +\n          \"</tbody></table><p>generated at <code>\" +\n          sc.generatedAt +\n          \"</code></p>\";\n      }\n\n      // ----------------------------------------------------------------- //\n      // Handshake.\n      //\n      // Done twice on purpose, to document a trap this experiment fell into.\n      //\n      // SEP-1865's narrative \"you don't need an SDK\" example sends\n      // `clientInfo` — but that example is for the BASE `initialize` method.\n      // The normative type for `ui/initialize` (McpUiInitializeRequest) requires\n      // `appInfo`, `appCapabilities`, `protocolVersion`. Copying the narrative\n      // example into a `ui/initialize` call gets you rejected, and the first\n      // call below records exactly that rejection rather than asserting it.\n      // ----------------------------------------------------------------- //\n      collectEnv();\n\n      // 1. The wrong shape, sent deliberately.\n      sendRequest(\"ui/initialize\", {\n        capabilities: {},\n        clientInfo: { name: \"fleet-card-probe\", version: \"1.0.0\" },\n        protocolVersion: \"2026-01-26\",\n      })\n        .then((result) => {\n          report.lifecycle.push({\n            kind: \"ui/initialize with clientInfo UNEXPECTEDLY ACCEPTED\",\n            result,\n          });\n          emit();\n        })\n        .catch((e) => {\n          report.lifecycle.push({\n            kind: \"ui/initialize with clientInfo REJECTED (expected)\",\n            error: String(e),\n          });\n          emit();\n        })\n        .finally(() => {\n          // 2. The shape the normative schema actually specifies.\n          sendRequest(\"ui/initialize\", {\n            appInfo: { name: \"fleet-card-probe\", version: \"1.0.0\" },\n            appCapabilities: { availableDisplayModes: [\"inline\"] },\n            protocolVersion: \"2026-01-26\",\n          })\n            .then((result) => {\n              report.lifecycle.push({ kind: \"ui/initialize with appInfo ACCEPTED\", result });\n              sendNotification(\"ui/notifications/initialized\", {});\n              emit();\n            })\n            .catch((e) => {\n              report.lifecycle.push({ kind: \"ui/initialize with appInfo FAILED\", error: String(e) });\n              sendNotification(\"ui/notifications/initialized\", {});\n              emit();\n            });\n        });\n\n      setTimeout(emit, 8000);\n    </script>\n  </body>\n</html>\n"
    }
  ]
}
