{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SiteS3Metadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetAccelerateConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::yopa.page",
        "arn:aws:s3:::yopa.page-cloudfront-logs-831597648506",
        "arn:aws:s3:::terraform.yopa.page"
      ]
    },
    {
      "Sid": "SiteStateRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::terraform.yopa.page/env/global/terraform.tfstate",
        "arn:aws:s3:::terraform.yopa.page/env/prod/terraform.tfstate"
      ]
    },
    {
      "Sid": "CloudFrontAndCertificateRead",
      "Effect": "Allow",
      "Action": [
        "cloudfront:Get*",
        "cloudfront:List*",
        "acm:ListCertificates",
        "acm:DescribeCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PresenceRoleRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::831597648506:role/article-atlas-presence-lambda-role"
    },
    {
      "Sid": "PresenceLambdaRead",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:GetFunctionConcurrency",
        "lambda:ListVersionsByFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-1:831597648506:function:article-atlas-presence-handler"
    },
    {
      "Sid": "PresenceTableRead",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:831597648506:table/article-atlas-presence"
    },
    {
      "Sid": "PresenceApiRead",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/dueijpig2e",
        "arn:aws:apigateway:us-east-1::/apis/dueijpig2e/*"
      ]
    },
    {
      "Sid": "PresenceLogRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PresenceLogTags",
      "Effect": "Allow",
      "Action": [
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/lambda/article-atlas-presence-handler",
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/apigateway/article-atlas-presence",
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/lambda/article-atlas-presence-handler:*",
        "arn:aws:logs:us-east-1:831597648506:log-group:/aws/apigateway/article-atlas-presence:*"
      ]
    },
    {
      "Sid": "SiteFunctionDescribe",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DescribeFunction"
      ],
      "Resource": [
        "arn:aws:cloudfront::831597648506:function/yopa-draw-index-rewrite",
        "arn:aws:cloudfront::831597648506:function/article-atlas-presence-rewrite"
      ]
    },
    {
      "Sid": "SitePublicCertificateRead",
      "Effect": "Allow",
      "Action": [
        "acm:GetCertificate"
      ],
      "Resource": "arn:aws:acm:us-east-1:831597648506:certificate/77504dc7-49c2-42fb-96cb-413e78d3a05f"
    }
  ]
}
